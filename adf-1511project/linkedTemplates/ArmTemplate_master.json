{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-1511project"
		},
		"sink_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'sink_adls'"
		},
		"ls_accounts_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/Savan2110/"
		},
		"ls_data_dictionary_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/Savan2110/"
		},
		"ls_products_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com/Savan2110/"
		},
		"ls_sales_pipeline_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/Savan2110/"
		},
		"ls_sales_teams_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/Savan2110/"
		},
		"sink_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://datacenter1511.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-1511project_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"sink_adls_accountKey": {
						"value": "[parameters('sink_adls_accountKey')]"
					},
					"ls_accounts_properties_typeProperties_url": {
						"value": "[parameters('ls_accounts_properties_typeProperties_url')]"
					},
					"ls_data_dictionary_properties_typeProperties_url": {
						"value": "[parameters('ls_data_dictionary_properties_typeProperties_url')]"
					},
					"ls_products_properties_typeProperties_url": {
						"value": "[parameters('ls_products_properties_typeProperties_url')]"
					},
					"ls_sales_pipeline_properties_typeProperties_url": {
						"value": "[parameters('ls_sales_pipeline_properties_typeProperties_url')]"
					},
					"ls_sales_teams_properties_typeProperties_url": {
						"value": "[parameters('ls_sales_teams_properties_typeProperties_url')]"
					},
					"sink_adls_properties_typeProperties_url": {
						"value": "[parameters('sink_adls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}